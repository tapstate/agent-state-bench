diff --git a/common_scaffold/tools/db_utils/mysql_utils.py b/common_scaffold/tools/db_utils/mysql_utils.py
new file mode 100644
index 000000000..66034f98f
--- /dev/null
+++ b/common_scaffold/tools/db_utils/mysql_utils.py
@@ -0,0 +1,111 @@
+import os
+import subprocess
+import logging
+
+import pandas as pd
+import pymysql
+import sqlalchemy
+
+from common_scaffold.tools.BaseTool import FatalError
+from common_scaffold.tools.db_utils import db_config
+
+"""
+MySQL Config:
+- db_type: mysql
+- db_name
+- sql_file
+Server and credentials come from MYSQL_HOST, MYSQL_PORT, MYSQL_USER and MYSQL_PASSWORD.
+Queries run in a read-only transaction, as Postgres queries do.
+"""
+
+
+def _ident(identifier: str) -> str:
+    return "`" + identifier.replace("`", "``") + "`"
+
+
+def _connect(db_name=None):
+    return pymysql.connect(host=db_config.MYSQL_HOST, port=db_config.MYSQL_PORT, user=db_config.MYSQL_USER,
+                           password=db_config.MYSQL_PASSWORD, database=db_name, charset="utf8mb4")
+
+
+def check_db_exists(db_name):
+    try:
+        with _connect() as conn, conn.cursor() as cur:
+            cur.execute("SELECT 1 FROM information_schema.schemata WHERE schema_name = %s", (db_name,))
+            return cur.fetchone() is not None
+    except Exception as e:
+        raise FatalError(f"MySQL existence check error ({type(e).__name__}): {str(e)}")
+
+
+def load_db(sql_file: str, db_name: str):
+    if os.getenv("DAB_PERSISTENT_DBS") and check_db_exists(db_name):
+        return
+    if check_db_exists(db_name):
+        logging.getLogger(__name__).warning(f"Database '{db_name}' already exists. Cleaning up before loading dump.")
+        clean_up(db_name)
+    try:
+        with _connect() as conn, conn.cursor() as cur:
+            cur.execute(f"CREATE DATABASE {_ident(db_name)} CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin")
+        cmd = [db_config.MYSQL_CLIENT, f"-h{db_config.MYSQL_HOST}", f"-P{db_config.MYSQL_PORT}",
+               f"-u{db_config.MYSQL_USER}", db_name]
+        env = os.environ.copy()
+        env["MYSQL_PWD"] = db_config.MYSQL_PASSWORD
+        with open(sql_file, "rb") as f:
+            result = subprocess.run(cmd, check=True, env=env, stdin=f, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        if result.stderr:
+            logging.getLogger(__name__).warning(f"MySQL load stderr: {result.stderr.decode(errors='replace')}")
+    except Exception as e:
+        raise FatalError(f"MySQL load error ({type(e).__name__}): {str(e)}")
+
+
+def clean_up(db_name):
+    if os.getenv("DAB_PERSISTENT_DBS"):
+        return
+    try:
+        with _connect() as conn, conn.cursor() as cur:
+            cur.execute(f"DROP DATABASE IF EXISTS {_ident(db_name)}")
+    except Exception as e:
+        raise FatalError(f"MySQL cleanup error ({type(e).__name__}): {str(e)}")
+
+
+def _engine(db_name):
+    uri = (f"mysql+pymysql://{db_config.MYSQL_USER}:{db_config.MYSQL_PASSWORD}"
+           f"@{db_config.MYSQL_HOST}:{db_config.MYSQL_PORT}/{db_name}?charset=utf8mb4")
+    return sqlalchemy.create_engine(uri)
+
+
+class MysqlQueryDBTool:
+    @staticmethod
+    def check_args(db_client, query):
+        if 'db_name' not in db_client:
+            raise FatalError(f"Missing `db_name` for mysql db_client: {db_client}")
+        return {"db_name": db_client["db_name"], "sql": query}
+
+    @staticmethod
+    def exec(db_name, sql):
+        with _engine(db_name).connect() as conn:
+            try:
+                conn.execute(sqlalchemy.text("SET SESSION TRANSACTION READ ONLY"))
+                result_df = pd.read_sql(sqlalchemy.text(sql), conn)
+            except Exception as e:
+                raise ValueError(f"MySQL query execution error ({type(e).__name__}): {str(e)}")
+        return db_config.serialize(result_df)
+
+
+class MysqlListDBTool:
+    @staticmethod
+    def check_args(db_client):
+        if 'db_name' not in db_client:
+            raise FatalError(f"Missing `db_name` for mysql db_client: {db_client}")
+        return {"db_name": db_client["db_name"]}
+
+    @staticmethod
+    def exec(db_name):
+        with _engine(db_name).connect() as conn:
+            try:
+                rows = conn.execute(sqlalchemy.text(
+                    "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() "
+                    "ORDER BY table_name")).fetchall()
+                return [r[0] for r in rows]
+            except Exception as e:
+                raise FatalError(f"MySQL list tables execution error ({type(e).__name__}): {str(e)}")
