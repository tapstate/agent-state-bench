#!/bin/sh
# Stand-in for the harness's `mysql -h.. -P.. -u.. DB < FILE`: runs the mysql client inside the
# MySQL container (no client is installed on the host); the SQL arrives on stdin.
db=
for a in "$@"; do
  case "$a" in -*) ;; *) db="$a" ;; esac
done
exec docker exec -i -e MYSQL_PWD="${MYSQL_PWD:-${MYSQL_PASSWORD:-secret}}" "${DAB_MYSQL_CONTAINER:-mfg-bench-mysql-1}" \
  mysql -uroot $db
